# Valores de ejemplo exclusivos para una demostración local.
# Copia este archivo a .env. Cambia las credenciales para cualquier otro uso.
DB_NAME=legaldeadline
DB_USER=legaldeadline
DB_PASSWORD=PostgresDemo123!
DB_PORT=5432
BACKEND_PORT=8081
FRONTEND_PORT=4200

# Debe contener al menos 32 bytes. Reemplaza este valor por una clave aleatoria.
JWT_SECRET=clave-demo-local-cambiar-por-una-clave-aleatoria-de-32-bytes
JWT_EXPIRATION_SECONDS=3600

# Carga idempotente de usuarios y expedientes de demostración.
# Pon false para desactivar la carga de ejemplos en siguientes arranques.
SPRING_PROFILES_ACTIVE=demo
DEMO_ENABLED=true

# --- Base en Neon (opcional) ---
# Pega aquí la cadena de conexión de Neon (conexión directa, sin "pooler"), sin comillas.
# Con DATABASE_URL, el backend ignora DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD. Ver docs/neon.md.
# DATABASE_URL=postgresql://neondb_owner:clave@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
